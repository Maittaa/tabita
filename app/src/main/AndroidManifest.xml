<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

<!-- openScale: чтение измерений через его ContentProvider -->
    <uses-permission android:name="com.health.openscale.READ_WRITE_DATA" />
    <uses-permission android:name="com.health.openscale.oss.READ_WRITE_DATA" />
    <uses-permission android:name="com.health.openscale.pro.READ_WRITE_DATA" />
    <uses-permission android:name="com.health.openscale.beta.READ_WRITE_DATA" />
    <uses-permission android:name="com.health.openscale.light.READ_WRITE_DATA" />
    <uses-permission android:name="com.health.openscale.debug.READ_WRITE_DATA" />

    <queries>
        <!-- приложения, работающие с Health Connect, — чтобы показывать их названия -->
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.google.android.apps.wearables.maestro.companion" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.mi.health" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.huami.midong" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.health.openscale" />
        <package android:name="com.health.openscale.oss" />
        <package android:name="com.health.openscale.pro" />
        <package android:name="com.health.openscale.beta" />
        <package android:name="com.health.openscale.light" />
        <package android:name="com.health.openscale.debug" />
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".TabitaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_dog"
        android:roundIcon="@mipmap/ic_dog"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tabita">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconDiary"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_dog"
            android:roundIcon="@mipmap/ic_dog"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconMan"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_dog"
            android:roundIcon="@mipmap/ic_dog"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconWoman"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_girl"
            android:roundIcon="@mipmap/ic_girl"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconZen"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_protein"
            android:roundIcon="@mipmap/ic_protein"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (5.9) -->
        <activity-alias
            android:name=".IconEgg"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_egg"
            android:roundIcon="@mipmap/ic_egg"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (5.9) -->
        <activity-alias
            android:name=".IconSkull"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_skull"
            android:roundIcon="@mipmap/ic_skull"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconPeak"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_protein"
            android:roundIcon="@mipmap/ic_protein"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- вариант значка (имена алиасов сохранены от прошлых версий, чтобы значок не пропадал) -->
        <activity-alias
            android:name=".IconChisel"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_dog"
            android:roundIcon="@mipmap/ic_dog"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
